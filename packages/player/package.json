{
  "name": "@unysonplus/scene-player",
  "version": "0.0.4",
  "private": true,
  "description": "Plays Unyson+ Animation Studio scene files in any web page.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate.ts",
    "./types": "./src/types.ts",
    "./catalog": "./src/presets/catalog.ts",
    "./dist/*": "./dist/*",
    "./groups": "./src/groups.ts"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.editor.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
